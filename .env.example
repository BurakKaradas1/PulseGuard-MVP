# Copy this file to ".env" (same folder as docker-compose.yml) and
# fill in real values. docker-compose reads this automatically.
#
# Must match the PULSEGUARD_SECRET the agent uses on the Windows host
# (pulseguard-agent/.env), otherwise the collector will reject every
# batch with an HMAC signature error.
PULSEGUARD_SECRET=super-gizli-sifre

# Optional: Slack Incoming Webhook URL for threshold alerts. Leave
# empty to disable.
SLACK_WEBHOOK_URL=

# Address the DASHBOARD (running in your browser) should use to
# reach the collector. Since the browser runs on your Windows host,
# not inside the Docker network, this must be a host-reachable
# address - localhost:8080 works because the collector's port is
# published to the host in docker-compose.yml.
VITE_API_BASE_URL=http://localhost:8080
